{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/cron/daily-price-sync.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    },
    "api/ai/*.js": {
      "maxDuration": 120
    }
  },
  "schedules": {
    "daily-price-sync": {
      "schedule": "0 7 * * *",
      "timezone": "America/Sao_Paulo",
      "function": "api/cron/daily-price-sync"
    }
  },
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/gestao",
      "/gestao.html",
      "/gestao.css",
      "/gestao.js",
      "/gestao-data.js",
      "/gestao-ai.js",
      "/api/gestao-state",
      "/api/ai/status",
      "/api/ai/price-sync",
      "/api/ai/assistant",
      "/api/ai/tools"
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/gestao(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
